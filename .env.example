# Copy to .env and replace the values. .env is ignored by git.
# Docker Compose reads this file, and so does the app when run from an IDE or `mvn spring-boot:run`.
POSTGRES_PASSWORD=replace-me
ADMIN_TOKEN=replace-me

# Optional: point the app at another database (for example Neon) when running outside Docker.
# DATABASE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
# DATABASE_USERNAME=<user>
# DATABASE_PASSWORD=<password>

# Optional: a real provider speaking the OpenAI chat completions API.
# Each model in OPENAI_MODELS also needs a price under gateway.pricing.models in application.yml.
# OPENAI_API_KEY=<provider key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o-mini
